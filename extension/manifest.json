{
  "manifest_version": 3,
  "name": "Web Ingest",
  "version": "0.1.0",
  "description": "Clip the current page as markdown to a local folder.",
  "permissions": ["nativeMessaging", "activeTab", "scripting", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Clip page as markdown",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
